# GEMINI_API_KEY: Required for Gemini Free-Tier AI API calls (script writing, search grounding, moderation, and host voice TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional backend origin if hosting the separate Viewer App (/watch) on its own domain.
VITE_API_BASE_URL=""
